model Courier {
  id                 BigInt              @id @default(autoincrement())
  userId             BigInt              @unique @map("user_id")
  hubId              BigInt              @map("hub_id")
  vehicleType        String              @map("vehicle_type") @db.VarChar(50)
  vehicleNumber      String              @map("vehicle_number") @db.VarChar(50)
  availabilityStatus CourierAvailability @default(AVAILABLE) @map("availability_status")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  // Relations
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_couriers_user")
  hub              Hub                 @relation(fields: [hubId], references: [id], onDelete: Restrict, map: "fk_couriers_hub")
  assignments      CourierParcel[]
  deliveryAttempts DeliveryAttempt[]
  @@map("couriers")
}