
model ShipmentStatusHistory {
  id         BigInt         @id @default(autoincrement())
  shipmentId BigInt         @map("shipment_id")
  status     ShipmentStatus
  location   String?        @db.VarChar(255)
  note       String?        @db.Text
  updatedBy  BigInt?        @map("updated_by")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  // Relations
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade, map: "fk_status_history_shipment")
  updater  User?    @relation("UserStatusUpdates", fields: [updatedBy], references: [id], onDelete: SetNull, map: "fk_status_history_user")
  @@index([shipmentId], map: "idx_shipment_history_shipment")
  @@map("shipment_status_history")
}